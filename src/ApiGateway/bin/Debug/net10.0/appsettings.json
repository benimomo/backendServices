{
  "ReverseProxy": {
    "Routes": {
      "book-service-route": {
        "ClusterId": "book-service-cluster",
        "Match": {
          "Path": "/api/books/{**catch-all}"
        }
      },
      "auth-service-route": {
        "ClusterId": "auth-service-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "book-service-cluster": {
        "Destinations": {
          "book-destination": {
            "Address": "http://localhost:5001/"
          }
        }
      },
      "auth-service-cluster": {
        "Destinations": {
          "auth-destination": {
            "Address": "http://localhost:5002/"
          }
        }
      }
    }
  }
}